# Copy to hsync.local.env (gitignored) and `chmod 600 hsync.local.env`.
# Loaded by ./hsync, ./run_sync.sh and update_daily_summary.py. Format: HSYNC_NAME=value, one per line;
# only HSYNC_* keys, nothing is expanded or executed, variables already set in the environment win.
# Every line is optional; unset values use the defaults listed in README.md.

# HSYNC_APP_DIR=/path/to/health-sync          # secrets/, state.json, raw/, audit/ (default: the repo dir)
# HSYNC_OUT_DIR=/path/to/health/daily          # daily JSON files (default: <app dir>/daily)
# HSYNC_TZ=America/New_York                    # what a "day" is (default: system timezone, else UTC)
# HSYNC_UPDATE_CSV=1                           # run_sync.sh also fills daily_summary.csv (default: 0)
# HSYNC_SUMMARY_CSV=/path/to/daily_summary.csv # default: daily_summary.csv next to the output dir
